<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 3.32: the full-screen keyboard reads the motion sensor at its fastest rate (Android 12+ asks for this; no prompt) -->
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.software.midi" android:required="false" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <!-- 3.36 → MIX: the Maker Hip INBOX (INBOX.md of 16 Track). Only apps signed with the same key get the permission. -->
    <permission android:name="com.makerhip.permission.INBOX" android:protectionLevel="signature" />
    <uses-permission android:name="com.makerhip.permission.INBOX" />
    <queries>
        <package android:name="com.makerhip.track16" />
    </queries>

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="${appLabel}"
        android:theme="@style/BurgerTheme">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 3.36 → MIX: the boxes of stems that 16 Track reads (InboxProvider.kt) -->
        <provider
            android:name=".InboxProvider"
            android:authorities="${applicationId}.inbox"
            android:exported="true"
            android:readPermission="com.makerhip.permission.INBOX"
            android:writePermission="com.makerhip.permission.INBOX" />
    </application>

</manifest>
