<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 3.32: the full-screen keyboard reads the motion sensor at its fastest rate (Android 12+ asks for this; no prompt) -->
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />
    <!-- 3.55: the FM-1 over Bluetooth MIDI. Android 12+: "Nearby devices" (the scan is not used for location);
         before that a Bluetooth LE scan needs the location permission -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.software.midi" android:required="false" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <!-- 3.36 → MIX: the Maker Hip INBOX (INBOX.md of 16 Track). Only apps signed with the same key get the permission.
         3.66: the Maker Hip release key; the permission, the authority and 16 Track's package have new names, so this
         pair installs beside the pair of before (whose names stay theirs) -->
    <permission android:name="com.makerhip.studio.permission.INBOX" android:protectionLevel="signature" />
    <uses-permission android:name="com.makerhip.studio.permission.INBOX" />
    <queries>
        <package android:name="com.makerhip.track16.studio" />
    </queries>

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="Burger Studio Lab"
        android:theme="@style/BurgerTheme">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 3.36 → MIX: the boxes of stems that 16 Track reads (InboxProvider.kt) -->
        <provider
            android:name=".InboxProvider"
            android:authorities="com.makerhip.burgerstudio.inbox"
            android:exported="true"
            android:readPermission="com.makerhip.studio.permission.INBOX"
            android:writePermission="com.makerhip.studio.permission.INBOX" />
    </application>

</manifest>
